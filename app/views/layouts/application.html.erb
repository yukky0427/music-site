<!DOCTYPE html>
<html>
  <head>
    <title>MUSIC REC</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://kit.fontawesome.com/b71b285230.js"  crossorigin="anonymous"></script> 

    
    
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
   <header>
    <h1>MUSIC REC</h1>
    <div class="header-list">
     <ul>
     
       <li><%= link_to "トップページ", pages_home_path %></li>
       <li><%= link_to "新規登録", new_user_registration_path %></li>
       <li><%= link_to "ログイン", new_user_session_path %></li>

       <% if current_user %>
       <li><%= link_to "マイページ", user_path(current_user.id) %>
       
       

       <li><%= link_to 'ログアウト', destroy_user_session_path, method: :delete, class: 'logout-button' %>
       


       
       <% end %>
     </ul>
   </div>
 </header>
 <main>
  <%= yield %>
 </main>
<footer></footer>
 </body>
</html>
